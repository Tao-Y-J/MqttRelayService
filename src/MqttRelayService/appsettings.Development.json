{
    // 说明：本文件是开发环境覆盖配置，与 appsettings.json 同时加载并逐键覆盖，这里为便于查阅列出了全部键，
    // 实际生效值以本文件为准，未列出的键才沿用 appsettings.json。
    // 服务按 DOTNET_ENVIRONMENT / ASPNETCORE_ENVIRONMENT 选择环境文件，未设置时按 Production 只加载 appsettings.json。

    // ===== 服务身份 =====
    "Service": {
        // 服务名称：同时作为 Windows 服务名（install-service.ps1 / uninstall-service.ps1 会读取此处）和日志中的 ServiceName 属性，改名后需重新执行安装脚本
        "Name": "MqttRelayService"
    },

    // ===== MQTT Broker =====
    "Mqtt": {
        // MQTT 监听端口，客户端通过 mqtt://<本机IP>:<端口> 接入
        "TcpPort": 1883,
        // 默认 QoS 等级（0/1/2）：服务端注入消息未指定 QoS 或指定越界时回退到该值
        "DefaultQos": 1
    },

    // ===== 客户端认证 =====
    "Auth": {
        // true = 允许匿名接入（仍要求 ClientId 非空，但不校验账号密码）；生产环境建议改为 false 并配置 Users
        "AllowAnonymous": true,
        // 账号列表：仅在 AllowAnonymous 为 false 时生效
        "Users": [
            {
                // 登录用户名
                "Username": "app1",
                // 登录密码
                "Password": "123456",
                // 该账号允许使用的 ClientId 前缀，留空表示不限制
                "ClientIdPrefix": "app1"
            }
        ]
    },

    // ===== 消息路由 =====
    "Routing": {
        // true = 消息也回发给发送方自己；保持 false 可避免自回环
        "EchoToSender": false
    },

    // ===== 转发可靠性 =====
    "Reliability": {
        // 投递语义：目前只支持 AtLeastOnce（至少一次），填其它值启动即报错
        "DeliverySemantics": "AtLeastOnce",
        // 内部转发队列容量上限；队列满时按 DropWhenQueueFull 决定阻塞等待还是丢弃。开发环境调小以便复现队列压力
        "QueueCapacity": 1000,
        // 入队等待超时（毫秒）：队列满且不丢弃时，超过该时间仍未入队即计为失败
        "EnqueueTimeoutMs": 2000,
        // 转发并发度，即同时处理的消息数，运行期可通过 API 调整，上限为 MaxConcurrencyHardLimit
        "MaxConcurrentHandlers": 1,
        // 单条消息最大重试次数，超过后进入死信（EnableDeadLetter 为 true 时）
        "MaxRetryCount": 3,
        // 处于退避等待中的后台重试任务上限，防止失败洪峰造成无界内存增长；建议不大于 QueueCapacity
        "MaxPendingRetryTasks": 1000,
        // 重试基础延迟（毫秒）：退避延迟从该值开始逐次翻倍
        "RetryBaseDelayMs": 1000,
        // 重试最大延迟（毫秒）：退避翻倍的上限
        "RetryMaxDelayMs": 30000,
        // 是否启用死信：重试耗尽的消息写入 DeadLetterPath 落盘保存
        "EnableDeadLetter": true,
        // 死信文件目录，相对服务可执行文件所在目录
        "DeadLetterPath": "data/deadletter",
        // 死信日期目录保留天数：写入死信时清理更早的日期目录，0 或负数表示不清理、由运维手工维护
        "DeadLetterRetentionDays": 30,
        // 单次转发（投递给订阅者）超时（毫秒）
        "ForwardTimeoutMs": 5000,
        // 停机排空超时（毫秒）：应不小于 RetryMaxDelayMs，否则最后一批重试会在停机时被放弃
        "ShutdownDrainTimeoutMs": 30000,
        // 队列满时是否丢弃新消息：false = 阻塞等待（受 EnqueueTimeoutMs 限制），true = 直接丢弃
        "DropWhenQueueFull": false,
        // 运行期通过 API 调整并发度时的硬上限，防止误调到过高值
        "MaxConcurrencyHardLimit": 200
    },

    // ===== Web 管理面 =====
    "Web": {
        // 是否启用 Web 管理面：false = 只跑 MQTT 转发，不监听 HTTP，同时不启用审计存储及其清理任务
        "Enabled": true,
        // Web 管理面监听端口，浏览器访问 http://<本机IP>:<端口>
        "Port": 5000,
        // API 访问密钥：null = 不校验（仅限可信内网）；填写后请求需携带 X-Api-Key 请求头且值一致
        "ApiKey": null
    },

    // ===== 审计数据存储 =====
    "AuditStorage": {
        // 数据库类型：Sqlite 为默认值，其它值（如 SqlServer / MySql）透传给 SqlSugar
        "Provider": "Sqlite",
        // 连接字符串：Sqlite 使用 Data Source=<文件路径>，相对路径以服务可执行文件所在目录为基准
        "ConnectionString": "Data Source=data/audit.db",
        // 是否在启动时自动建表：false = 需要人工预先建表，否则审计功能不可用
        "AutoInitializeSchema": true,
        // 消息审计表容量提示阈值（行数）：仅在启动时记录告警日志，不触发删除
        "MessageArchiveThreshold": 5000000,
        // 客户端历史表容量提示阈值（行数）：仅在启动时记录告警日志，不触发删除
        "ClientHistoryArchiveThreshold": 1000000,
        // 审计数据保留天数（消息审计表 + 客户端历史表）：清理时删除早于「当前本机时间 - 该天数」的记录，0 或负数表示关闭清理
        "RetentionDays": 30,
        // 每日清理时刻（本机时间整点，取值 0-23）：每天该时刻执行一次清理；置为 null 则改用 CleanupIntervalMinutes 等间隔执行
        "CleanupAtHour": 3,
        // CleanupAtHour 为 null 时的清理间隔（分钟，取值 1-1440）：上限 1440 保证每天至少清理一次，填更大会启动报错
        "CleanupIntervalMinutes": 1440,
        // 清理后是否对 SQLite 执行 VACUUM 回收数据库文件空间：VACUUM 独占数据库且需要重写整库，大库耗时可观，需要更短清理窗口时改为 false
        "VacuumAfterCleanup": true
    },

    // ===== 日志 =====
    "Serilog": {
        // 日志文件前缀：日志写入 <服务目录>/Logs/<前缀>-<时间>.log，按小时滚动
        "FileNamePrefix": "relay",
        // 日志文件保留天数，内部按「该天数 x 24」个滚动文件保留。开发环境只留 7 天
        "RetentionDays": 7,
        // 是否在日志中输出调用者信息（{Caller} 字段）：开启后每条日志都要解析调用栈，有额外性能开销。开发环境开启便于定位
        "IncludeCallerInfo": true,
        // 全局最低日志级别
        "MinimumLevel": {
            // 取值 Verbose / Debug / Information / Warning / Error / Fatal。开发环境用 Debug
            "Default": "Debug",
            // 按日志类别名覆盖级别：Microsoft 类的框架日志只记 Warning 及以上
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        }
    }
}
